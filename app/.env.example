# ── Backend (Railway) ─────────────────────────────────────────────────────────
# Set this to your Railway deployment URL once the server is live.
# Without it, the frontend uses mock data.
BACKEND_URL=https://your-server.up.railway.app

# ── Solana RPC ────────────────────────────────────────────────────────────────
# Public-facing RPC used by the browser wallet (Phantom, Solflare).
# Get a free key at https://helius.dev — or leave blank for public devnet.
NEXT_PUBLIC_HELIUS_RPC=https://api.devnet.solana.com

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must match JWT_SECRET in the Railway backend so tokens are accepted.
JWT_SECRET=change-me-in-production

# ── Program ──────────────────────────────────────────────────────────────────
# Solana program ID — only override if you redeploy to a different address.
NEXT_PUBLIC_PROGRAM_ID=FPoAMRkM3kXfuvFn1iC2cM8B554KfnaPjibjLH31CHtd

# ── Devnet USDC faucet (Option B: funded reserve) ─────────────────────────────
# Reserve wallet secret key (base58 or JSON array) holding devnet USDC from
# spl-token-faucet.com. Seed it once: node scripts/fund-reserve.mjs
# Without FAUCET_KEYPAIR the /api/v1/faucet endpoint returns 503.
# FAUCET_KEYPAIR=
# Optional: RPC for the faucet transfers (default: NEXT_PUBLIC_HELIUS_RPC or
# api.devnet.solana.com).
# FAUCET_RPC_URL=

